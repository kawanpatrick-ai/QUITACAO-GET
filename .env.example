# Valores públicos do projeto Supabase (publishable key pode ser exposta no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://ntkvwdyifxayoksjihih.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sii-UgRDXDXFUYDEKeLorA_-q4rVZAF

# Somente servidor. Use a secret key sb_secret_... ou a chave legada service_role.
# Nunca usar NEXT_PUBLIC_ para esta variável e nunca commitar o valor.
SUPABASE_SERVICE_ROLE_KEY=

# O código atual ainda usa ADMIN_EMAIL fixo em lib/login.mjs; ADMIN_EMAILS não é consumido.
ADMIN_EMAILS=

# Opcional: proteção de chamadas automatizadas da rota /api/sync
CRON_SECRET=

# Integração Google Sheets: configure UMA alternativa de autenticação.
# Conta de serviço compartilhada somente com as planilhas autorizadas.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa OAuth do responsável autorizado:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# IDs das planilhas separados por vírgula; a aplicação só lê as abas autorizadas.
GOOGLE_SHEETS_IDS=

# Opcional: se não informado, o endpoint usa a chave pública do DataJud definida no código.
DATAJUD_API_KEY=
