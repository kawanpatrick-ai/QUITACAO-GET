# Dados públicos para autenticação no navegador (não incluir chaves service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor; nunca usar NEXT_PUBLIC_ para estas variáveis
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
CRON_SECRET=
# Conta de serviço Google compartilhada SOMENTE com as planilhas autorizadas
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa à conta de serviço: Google OAuth refresh token do responsável autorizado
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# IDs das fontes (a segunda poderá ser habilitada após concessão de acesso)
GOOGLE_SHEETS_IDS=
