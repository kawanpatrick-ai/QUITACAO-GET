</path></svg> Protegido por autenticação e políticas de acesso · W1 Capital</div></section></div></main><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-cf89d84629bf3c89.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[9766,[],\\\"\\\"]\\n3:I[8924,[],\\\"\\\"]\\n4:I[1959,[],\\\"ClientPageRoot\\\"]\\n5:I[7525,[\\\"903\\\",\\\"static/chunks/903-344136e209285a26.js\\\",\\\"959\\\",\\\"static/chunks/959-33077337d4ef22b5.js\\\",\\\"414\\\",\\\"static/chunks/414-ff8955d53b804d38.js\\\",\\\"974\\\",\\\"static/chunks/app/page-0437f3fa96e1648d.js\\\"],\\\"default\\\"]\\n8:I[4431,[],\\\"OutletBoundary\\\"]\\na:I[5278,[],\\\"AsyncMetadataOutlet\\\"]\\nc:I[4431,[],\\\"ViewportBoundary\\\"]\\ne:I[4431,[],\\\"MetadataBoundary\\\"]\\nf:\\\"$Sreact.suspense\\\"\\n11:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/4553e3b7281899d8.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/7705a777c23e316f.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"UzbtDLFuwNWM6k7gK1IdS\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/4553e3b7281899d8.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/7705a777c23e316f.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"pt-BR\\\",\\\"data-crm-theme\\\":\\\"corporate\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"childre